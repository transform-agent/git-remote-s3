cabal-version:      3.0
name:               git-remote-s3
version:            0.3.2
synopsis:           A git remote helper for Amazon S3
description:
  Enables using Amazon S3 as a Git remote and LFS server.
  Provides a git remote helper (git-remote-s3) and a git-lfs
  custom transfer agent (git-lfs-s3).

license:            Apache-2.0
license-file:       LICENSE
author:             Massimiliano Angelino
maintainer:         angmas@amazon.com
copyright:          2023-present Amazon.com, Inc. or its affiliates
category:           Development
homepage:           https://github.com/awslabs/git-remote-s3
bug-reports:        https://github.com/awslabs/git-remote-s3/issues
build-type:         Simple
extra-source-files: README.md NOTICE

-- -------------------------------------------------------------------
-- Library
-- -------------------------------------------------------------------
library
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing

  exposed-modules:
      GitRemoteS3
      GitRemoteS3.Enums
      GitRemoteS3.Common
      GitRemoteS3.Git
      GitRemoteS3.Remote
      GitRemoteS3.Lfs
      GitRemoteS3.Manage

  build-depends:
      base                >= 4.14  && < 5
    , text                >= 1.2   && < 2.2
    , bytestring          >= 0.10  && < 0.13
    , containers          >= 0.6   && < 0.8
    , process             >= 1.6   && < 1.7
    , regex-tdfa          >= 1.3   && < 1.4
    , aeson               >= 2.0   && < 2.3
    , optparse-applicative>= 0.17  && < 0.19
    , async               >= 2.2   && < 2.3
    , stm                 >= 2.5   && < 2.6
    , time                >= 1.9   && < 1.13
    , uuid                >= 1.3   && < 1.4
    , temporary           >= 1.3   && < 1.4
    , directory           >= 1.3   && < 1.4
    , filepath            >= 1.4   && < 1.5
    , exceptions          >= 0.10  && < 0.11
    , amazonka            >= 2.0   && < 2.1
    , amazonka-s3         >= 2.0   && < 2.1
    , amazonka-core       >= 2.0   && < 2.1
    , http-client         >= 0.7   && < 0.8
    , http-types          >= 0.12  && < 0.13
    , unliftio-core       >= 0.2   && < 0.3
    , lens                >= 5.0   && < 5.3
    , conduit             >= 1.3   && < 1.4
    , resourcet           >= 1.2   && < 1.4

-- -------------------------------------------------------------------
-- Executable: git-remote-s3  (also used as git-remote-s3+zip)
-- -------------------------------------------------------------------
executable git-remote-s3
  hs-source-dirs:   app
  main-is:          GitRemoteS3Main.hs
  default-language: Haskell2010
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N

  build-depends:
      base              >= 4.14 && < 5
    , text              >= 1.2  && < 2.2
    , git-remote-s3

-- -------------------------------------------------------------------
-- Executable: git-remote-s3-zip  (mirrors git-remote-s3+zip entry point)
-- -------------------------------------------------------------------
executable git-remote-s3-zip
  hs-source-dirs:   app
  main-is:          GitRemoteS3Main.hs
  default-language: Haskell2010
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N

  build-depends:
      base              >= 4.14 && < 5
    , text              >= 1.2  && < 2.2
    , git-remote-s3

-- -------------------------------------------------------------------
-- Executable: git-lfs-s3
-- -------------------------------------------------------------------
executable git-lfs-s3
  hs-source-dirs:   app
  main-is:          GitLfsS3Main.hs
  default-language: Haskell2010
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N

  build-depends:
      base              >= 4.14 && < 5
    , text              >= 1.2  && < 2.2
    , git-remote-s3

-- -------------------------------------------------------------------
-- Executable: git-s3  (manage / doctor)
-- -------------------------------------------------------------------
executable git-s3
  hs-source-dirs:   app
  main-is:          GitS3Main.hs
  default-language: Haskell2010
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N

  build-depends:
      base              >= 4.14 && < 5
    , text              >= 1.2  && < 2.2
    , git-remote-s3

-- -------------------------------------------------------------------
-- Test suite
-- -------------------------------------------------------------------
test-suite git-remote-s3-tests
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  default-language: Haskell2010
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N

  other-modules:
      ParseUrlSpec
      RemoteSpec
      ParallelFetchSpec

  build-depends:
      base              >= 4.14 && < 5
    , text              >= 1.2  && < 2.2
    , bytestring        >= 0.10 && < 0.13
    , containers        >= 0.6  && < 0.8
    , hspec             >= 2.9  && < 2.12
    , HUnit             >= 1.6  && < 1.7
    , stm               >= 2.5  && < 2.6
    , async             >= 2.2  && < 2.3
    , time              >= 1.9  && < 1.13
    , git-remote-s3
