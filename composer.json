{
    "name": "awslabs/git-remote-s3",
    "description": "A git remote helper for Amazon S3",
    "type": "project",
    "license": "Apache-2.0",
    "keywords": ["git", "s3", "remote", "lfs"],
    "require": {
        "php": ">=8.1",
        "aws/aws-sdk-php": "^3.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GitRemoteS3\\": "src/GitRemoteS3/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GitRemoteS3\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/git-remote-s3",
        "bin/git-lfs-s3",
        "bin/git-s3"
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
